# Copia este archivo como .env y coloca tus datos reales.
# .env NUNCA se sube al repositorio ni se comparte.

# Cadena de conexión de MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017
# MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Base de datos donde viven las colecciones de Nexora
MONGO_DB=nexora

# Zona horaria para calcular anticipación, recordatorios y bloques
ZONA_HORARIA=America/Mexico_City

# Puerto de Ionic / Angular permitido por CORS (separados por coma)
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,http://localhost:5173

# Reglas de reserva
ANTICIPACION_HORAS=24
DIAS_DISPONIBLES=5
MAX_BLOQUES=4
MAX_RESERVAS_ACTIVAS=3
RECORDATORIO_HORAS=24

# Claves de administración (se guardan con hash en la colección api_keys)
API_KEYS_ENABLED=true
